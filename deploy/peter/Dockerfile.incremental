# Rebuild application code with the already verified Go toolchain and native
# dependencies. This avoids a network-dependent OS package refresh on release.
ARG PETER_PREVIOUS_BUILD
FROM ${PETER_PREVIOUS_BUILD}
WORKDIR /app
COPY . .
ARG VERSION_ARG
ARG COMMIT_ID_ARG
ENV VERSION=${VERSION_ARG} COMMIT_ID=${COMMIT_ID_ARG}
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build make build-prod \
    && go test -c -tags=docker_integration ./internal/sandbox -o /app/sandbox-integration.test
