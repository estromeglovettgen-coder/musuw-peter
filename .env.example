# Local PostgreSQL only. Task 1.5 owns the repeatable database harness.
DATABASE_URL=postgresql://knowledge@127.0.0.1:55432/knowledge

# M1 fixture behavior is opt-in and remains disabled by default.
M1_FIXTURE_MODE=0

# Required only when M1_FIXTURE_MODE=1. Use at least 32 UTF-8 bytes; never commit a real value.
M1_SESSION_SECRET=

# Provisioned personal Workspace Access is opt-in and requires DATABASE_URL.
# Account creation is deliberately not an application-startup behavior.
M2_PERSONAL_MODE=0
M2_DRAFT_ROOT_SECRET=

# Standard sends the Codex-derived kernel directly to the fixed official
# DeepSeek Responses endpoint and reads only this key. Never paste a real key
# into this tracked template; inject it from an ignored local file or deployment
# secret store.
DEEPSEEK_API_KEY=
# The remaining DEEPSEEK_* settings belong only to the legacy fictional-live
# Chat acceptance profile; Standard does not read them.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
MUSNOW_DEEPSEEK_LIVE=0
# Set to rotated only after separate provider-account revocation/rotation evidence exists.
MUSNOW_DEEPSEEK_SECRET_STATE=

# Explicit fictional-data live acceptance profile. This is not a production
# profile and does not satisfy the separate provider-account key-rotation gate.
# Put real secrets only in the ignored .env.local or a process secret store.
MUSNOW_RUNTIME_PROFILE=fictional_local
# Formal standard runtime PostgreSQL URL. Remote hosts must explicitly use
# sslmode=require, verify-ca, or verify-full; local fictional Compose supplies
# its own loopback/container URL and may use sslmode=disable.
MUSNOW_POSTGRES_URL=
MUSNOW_DEEPSEEK_ACCEPTANCE_AUTHORIZED=0
MUSNOW_DEEPSEEK_AUTHORIZATION_ID=
MUSNOW_DEEPSEEK_CORPUS_SHA256=
MUSNOW_DEEPSEEK_REVIEW_ID=
MUSNOW_DEEPSEEK_FICTIONAL_ONLY=1

# Google-only external identity is required by the formal standard profile:
# configure the complete Supabase/Auth block and its allowed origins.
# Paddle Billing is optional: leave every MUSUW_PADDLE_* value empty to disable
# upgrades. Partial configuration fails closed. Never commit real keys. Price
# IDs are safe to expose to authenticated Paddle.js but remain a server-owned
# allowlist; point Paddle only at /api/v1/billing/paddle/webhook and subscribe
# it to the subscription lifecycle events plus transaction.completed.
MUSNOW_SUPABASE_URL=
MUSNOW_SUPABASE_PUBLISHABLE_KEY=
# Example local origin: http://127.0.0.1:4173
MUSNOW_AUTH_ALLOWED_ORIGINS=
# sandbox or live; never mix credentials or price IDs between them.
MUSUW_PADDLE_ENVIRONMENT=
# Server-only key with customer_portal_session.write plus subscription read/write
# for authenticated upgrade preview/update; never expose it to Paddle.js.
MUSUW_PADDLE_API_KEY=
MUSUW_PADDLE_CLIENT_TOKEN=
MUSUW_PADDLE_WEBHOOK_SECRET=
MUSUW_PADDLE_PLUS_MONTHLY_PRICE_ID=
MUSUW_PADDLE_PLUS_YEARLY_PRICE_ID=
MUSUW_PADDLE_PRO_MONTHLY_PRICE_ID=
MUSUW_PADDLE_PRO_YEARLY_PRICE_ID=
MUSUW_PADDLE_MAX_MONTHLY_PRICE_ID=
MUSUW_PADDLE_MAX_YEARLY_PRICE_ID=

# Formal Explorer Web Search/Web Fetch thin adapter. Standard uses the fixed,
# no-key upstream DuckDuckGo provider; public Web queries leave the service,
# while fetched page bodies stay in the SSRF-safe WeKnora fetcher and are sent
# directly to the primary Responses turn (not a second summary model call).
MUSNOW_WEB_SEARCH_PROVIDER=duckduckgo
MUSNOW_WEB_SEARCH_API_KEY=
MUSNOW_WEB_SEARCH_ENGINE_ID=
MUSNOW_WEB_SEARCH_BASE_URL=
MUSNOW_WEB_SEARCH_PROXY_URL=
MUSNOW_WEB_SEARCH_MAX_RESULTS=5
MUSNOW_WEB_SEARCH_INCLUDE_DATE=false
MUSNOW_WEB_SEARCH_TIMEOUT_SECONDS=10

# Musuw keeps one OpenRouter Management key for child-key control-plane calls.
# Runtime inference always uses the encrypted Personal Tenant child key.
OPENROUTER_MANAGEMENT_API_KEY=

# Optional provider-neutral WeKnora VLM adapter for image Source/attachment
# OCR. Leave the whole block empty to publish the real unavailable reason.
MUSNOW_VLM_API_KEY=
MUSNOW_VLM_BASE_URL=
MUSNOW_VLM_MODEL=
MUSNOW_VLM_PROVIDER=
