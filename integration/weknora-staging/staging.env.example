# Non-secret staging runtime contract fixture, not a deployable release file.
# The workflow replaces the example revision and image digests with the
# authorized SHA/digests, installs staging.public.env in the protected runtime
# directory, and then prepare-runtime.sh derives staging.env.
WEKNORA_STAGING_RELEASE_ID=weknora-v072-staging
WEKNORA_STAGING_REVISION=ec407d242ef22f39d9b5a4de561a709ef452bebb
WEKNORA_STAGING_APP_IMAGE=ghcr.io/estromeglovettgen-coder/musuw-app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
WEKNORA_STAGING_FRONTEND_IMAGE=ghcr.io/estromeglovettgen-coder/musuw-frontend@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
WEKNORA_STAGING_FRONTEND_PORT=4192
WEKNORA_STAGING_APP_PORT=18092
WEKNORA_STAGING_POSTGRES_VOLUME=weknora-v072-staging-postgres-data
WEKNORA_STAGING_FILES_VOLUME=weknora-v072-staging-data-files
WEKNORA_STAGING_DOCREADER_TMP_VOLUME=weknora-v072-staging-docreader-tmp
WEKNORA_STAGING_REDIS_VOLUME=weknora-v072-staging-redis-data
WEKNORA_STAGING_SEARXNG_CONFIG_VOLUME=weknora-v072-staging-searxng-config
MUSUW_STAGING_SECRET_DIR=/opt/weknora/staging-runtime/secrets
# TikHub social-share imports use the protected server file named
# tikhub_api_key; never place TIKHUB_API_KEY or its value in this public file.
MUSUW_STAGING_R2_ENDPOINT=https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.r2.cloudflarestorage.com
MUSUW_STAGING_R2_BUCKET=musuw-staging
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=weknora_staging
DB_NAME=WeKnoraStaging
REDIS_ADDR=redis:6379
STREAM_MANAGER_TYPE=redis
REDIS_DB=0
REDIS_PREFIX=stream:
WEKNORA_REDIS_NAMESPACE=weknora-v072-staging
NEO4J_ENABLE=true
STORAGE_TYPE=s3
LOCAL_STORAGE_BASE_DIR=/data/files
MAX_FILE_SIZE_MB=50
GIN_MODE=release
LOG_LEVEL=info
TZ=Asia/Shanghai
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=true
DISABLE_REGISTRATION=false
WEKNORA_AUTH_DEFAULT_TENANT_MODE=create_personal
# Staging is the consumer Lite deployment; keep this explicit so a missing
# runtime secret cannot silently expose the Standard workspace surface.
MUSUW_PRODUCT_EDITION=lite
APP_EXTERNAL_URL=https://staging.musuw.com
FRONTEND_BASE_URL=https://staging.musuw.com
OIDC_AUTH_ENABLE=true
OIDC_AUTH_ISSUER_URL=https://achfnnicetupvtoqiwqd.supabase.co/auth/v1
OIDC_AUTH_DISCOVERY_URL=https://achfnnicetupvtoqiwqd.supabase.co/auth/v1/.well-known/openid-configuration
OIDC_AUTH_PROVIDER_DISPLAY_NAME=Musuw
OIDC_AUTH_SCOPES=openid profile email
OIDC_USER_INFO_MAPPING_USER_NAME=name
OIDC_USER_INFO_MAPPING_EMAIL=email
MUSUW_PADDLE_ENVIRONMENT=sandbox
MUSUW_PADDLE_API_URL=https://sandbox-api.paddle.com
MUSUW_PADDLE_CLIENT_TOKEN=test_<sandbox-client-token>
MUSUW_PADDLE_PLUS_MONTHLY_PRICE_ID=pri_<sandbox-plus-monthly>
MUSUW_PADDLE_PLUS_YEARLY_PRICE_ID=pri_<sandbox-plus-yearly>
MUSUW_PADDLE_PRO_MONTHLY_PRICE_ID=pri_<sandbox-pro-monthly>
MUSUW_PADDLE_PRO_YEARLY_PRICE_ID=pri_<sandbox-pro-yearly>
MUSUW_PADDLE_MAX_MONTHLY_PRICE_ID=pri_<sandbox-max-monthly>
MUSUW_PADDLE_MAX_YEARLY_PRICE_ID=pri_<sandbox-max-yearly>
OPENROUTER_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_RELEASE=musuw-staging
LANGFUSE_ENVIRONMENT=staging
