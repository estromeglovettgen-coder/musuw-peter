# Native WeKnora UI plus the retained same-origin Supabase auth shell. It is
# presentation/proxy only; it neither implements a business API nor imports
# any legacy service.

ARG VERSION_ARG=main-81142df
ARG REVISION_ARG=local
FROM nginx:1.30.3-alpine@sha256:0d3b80406a13a767339fbe2f41406d6c7da727ab89cf8fae399e81f780f814d1

ARG VERSION_ARG=main-81142df
ARG REVISION_ARG=local

COPY weknora/frontend/dist /usr/share/nginx/html
COPY auth/dist /usr/share/nginx/html/auth
COPY integration/weknora-production/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY integration/weknora-production/auth-shell.nginx.conf /etc/nginx/weknora-auth-shell.conf
COPY weknora/frontend/docker-entrypoint.sh /docker-entrypoint.sh

RUN chmod +x /docker-entrypoint.sh

ENV MAX_FILE_SIZE_MB=50

LABEL org.opencontainers.image.version="${VERSION_ARG}" \
      org.opencontainers.image.revision="${REVISION_ARG}"

EXPOSE 8080
ENTRYPOINT ["/docker-entrypoint.sh"]
