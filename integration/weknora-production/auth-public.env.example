# Public browser coordinates only. Release tooling validates this file and
# derives the startup MUSUW_* runtime seam used by the shared frontend image;
# do not place a Supabase service-role key or OAuth client secret here.
VITE_AUTH_PUBLIC_ORIGIN=https://app.musuw.com
VITE_SUPABASE_URL=https://<supabase-project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
VITE_WEKNORA_OAUTH_CLIENT_ID=<public-oidc-client-id>
