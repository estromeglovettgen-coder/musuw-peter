{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musuw-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "musuw.com",
      "custom_domain": true
    },
    {
      "pattern": "www.musuw.com",
      "custom_domain": true
    },
    {
      "pattern": "partners.musuw.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
