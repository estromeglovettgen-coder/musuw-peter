#!/usr/bin/env bash
# Root-owned half of the restricted two-verb deployment seam.
#
# The SSH account may only populate one exact incoming release directory.  This
# wrapper is the only process that can verify that tree, move it into the
# immutable release root, and invoke the fixed release helper.
set -euo pipefail

if [ "${MUSUW_DEPLOY_GATE_TEST_MODE:-0}" != 1 ] || [ "${EUID:-1}" -eq 0 ]; then
    PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    export PATH
fi

die() {
    printf '%s\n' "$1" >&2
    exit 1
}

safe_revision() {
    [ "$#" -eq 1 ] || return 1
    [[ "$1" =~ ^[0-9a-fA-F]{40}$ ]]
}

test_mode=false
if [ "${MUSUW_DEPLOY_GATE_TEST_MODE:-0}" = 1 ] && [ "${EUID:-1}" -ne 0 ]; then
    test_mode=true
fi
if [ "$test_mode" = false ] && [ "${EUID:-1}" -ne 0 ]; then
    die 'musuw deploy gate must run as root'
fi

root_prefix=''
if [ "$test_mode" = true ]; then
    root_prefix="${MUSUW_DEPLOY_GATE_ROOT:-}"
    [ -n "$root_prefix" ] || die 'test gate root is unavailable'
    root_prefix="$(cd "$root_prefix" && pwd -P)"
fi

release_root="${root_prefix}/opt/weknora/releases"
current_link="${root_prefix}/opt/weknora/current"
runtime_dir="${root_prefix}/opt/weknora/runtime"
spool_root="${root_prefix}/var/lib/musuw-deploy/incoming"
deploy_user='musuw-deploy'

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required gate command is unavailable: $1"
}

for command_name in bash cat find id install mv ps readlink; do
    require_command "$command_name"
done

safe_dir() {
    local path="$1"
    [ -d "$path" ] && [ ! -L "$path" ] || die "unsafe deployment directory: $path"
}

ensure_root_dirs() {
    [ ! -e "$release_root" ] || [ -d "$release_root" ] || die 'production release root has an unsafe type'
    [ ! -e "$spool_root" ] || [ -d "$spool_root" ] || die 'deployment spool root has an unsafe type'
    install -d -m 755 "$release_root" "$spool_root"
    safe_dir "$release_root"
    safe_dir "$spool_root"
}

current_target() {
    local target link_target link_dir
    if [ ! -e "$current_link" ] && [ ! -L "$current_link" ]; then
        printf '%s' ''
        return 0
    fi
    [ -L "$current_link" ] || die 'production current path is not a symlink'
    target="$(readlink -f "$current_link" 2>/dev/null || true)"
    if [ -z "$target" ]; then
        link_target="$(readlink "$current_link" 2>/dev/null || true)"
        [ -n "$link_target" ] || die 'production current release target is unavailable'
        case "$link_target" in
            /*) target="$link_target" ;;
            *) target="$(dirname "$current_link")/$link_target" ;;
        esac
        link_dir="$(cd "$target" 2>/dev/null && pwd -P || true)"
        target="$link_dir"
    fi
    [ -n "$target" ] || die 'production current release target is unavailable'
    case "$target" in
        "$release_root"/*/source) ;;
        *) die 'production current release target is outside the approved root' ;;
    esac
    [ -d "$target" ] && [ ! -L "$target" ] || die 'production current release target is unavailable'
    printf '%s' "$target"
}

assert_not_current() {
    local target="$1"
    local current
    current="$(current_target)"
    [ "$target" != "$current" ] || die 'requested release is already current'
}

active_release_process() {
    local process_list pid args
    process_list="$(ps -eo pid=,args= 2>/dev/null || ps -eo pid=,command= 2>/dev/null)" || die 'active release processes could not be inspected'
    while IFS=' ' read -r pid args; do
        case "$pid" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$pid" = "$$" ] && continue
        case "$args" in
            *release-ci.sh*) return 0 ;;
        esac
    done <<< "$process_list"
    return 1
}

assert_no_active_release() {
    if active_release_process; then
        die "release process is active for $release_id"
    fi
}

clear_exact_tree() {
    local directory="$1"
    [ -d "$directory" ] && [ ! -L "$directory" ] || die "unsafe deployment tree: $directory"
    find "$directory" -mindepth 1 -depth -delete
}

incoming_dir() {
    printf '%s/%s' "$spool_root" "$release_id"
}

incoming_source() {
    printf '%s/source' "$(incoming_dir)"
}

prepared_marker() {
    printf '%s/.prepared' "$(incoming_dir)"
}

release_dir() {
    printf '%s/%s' "$release_root" "$release_id"
}

prepare_incoming() {
    local incoming source marker marker_tmp
    ensure_root_dirs
    assert_not_current "$(release_dir)/source"
    assert_no_active_release
    incoming="$(incoming_dir)"
    if [ -e "$incoming" ] || [ -L "$incoming" ]; then
        [ -d "$incoming" ] && [ ! -L "$incoming" ] || die 'release incoming directory has an unsafe type'
        clear_exact_tree "$incoming"
    else
        install -d -m 755 "$incoming"
    fi
    install -d -m 755 \
        "$incoming/source" \
        "$incoming/source/weknora" \
        "$incoming/source/auth" \
        "$incoming/source/integration/weknora-production" \
        "$incoming/source/scripts/weknora-production" \
        "$incoming/source/deploy"
    if [ "$test_mode" = false ]; then
        id "$deploy_user" >/dev/null 2>&1 || die 'dedicated deployment account is unavailable'
        chown "$deploy_user:$deploy_user" \
            "$incoming/source" \
            "$incoming/source/weknora" \
            "$incoming/source/auth" \
            "$incoming/source/integration" \
            "$incoming/source/integration/weknora-production" \
            "$incoming/source/scripts" \
            "$incoming/source/scripts/weknora-production" \
            "$incoming/source/deploy"
    fi
    marker="$(prepared_marker)"
    marker_tmp="$incoming/.prepared.$$"
    printf '%s\n' "$revision" > "$marker_tmp"
    chmod 600 "$marker_tmp"
    if [ "$test_mode" = false ]; then
        chown root:root "$marker_tmp"
    fi
    mv -f "$marker_tmp" "$marker"
    if [ "$test_mode" = false ]; then
        chown root:root "$marker"
    fi
    printf '%s\n' "release prepared: $release_id"
}

verify_prepared_source() {
    local source="$1"
    local manifest_script="$source/scripts/weknora-production/source-manifest.sh"
    [ -d "$source" ] && [ ! -L "$source" ] || die 'release source spool is unavailable'
    [ -z "$(find "$source" -type l -print -quit)" ] || die 'release source contains a symbolic link'
    [ -z "$(find "$source" \( -type b -o -type c -o -type p -o -type s \) -print -quit)" ] || die 'release source contains a special file'
    [ -f "$manifest_script" ] && [ ! -L "$manifest_script" ] || die 'release source manifest verifier is unavailable'
    [ -f "$source/deploy/source-manifest.sha256" ] && [ ! -L "$source/deploy/source-manifest.sha256" ] || die 'release source checksum manifest is unavailable'
    WEKNORA_PRODUCTION_RUNTIME_DIR="$runtime_dir" \
    WEKNORA_PRODUCTION_REVISION="$revision" \
        bash "$source/scripts/weknora-production/source-manifest.sh" verify "$source" >/dev/null
}

freeze_source() {
    local source="$1"
    find "$source" -mindepth 1 -type d -exec chmod a-w {} +
    find "$source" -type f -exec chmod a-w {} +
}

deploy_release() {
    local incoming source marker release target helper ghcr_username ghcr_token
    IFS= read -r ghcr_username || die 'GHCR username is missing from the deploy stream'
    IFS= read -r ghcr_token || die 'GHCR token is missing from the deploy stream'
    case "$ghcr_username" in
        ''|*[!A-Za-z0-9._-]*) die 'GHCR username is unsafe' ;;
    esac
    [ -n "$ghcr_token" ] || die 'GHCR token is empty'
    ensure_root_dirs
    release="$(release_dir)"
    target="$release/source"
    assert_not_current "$target"
    assert_no_active_release
    incoming="$(incoming_dir)"
    source="$(incoming_source)"
    marker="$(prepared_marker)"
    [ -f "$marker" ] && [ ! -L "$marker" ] || die 'release incoming directory is not prepared'
    [ "$(cat "$marker")" = "$revision" ] || die 'prepared release revision does not match the requested SHA'
    verify_prepared_source "$source"
    freeze_source "$source"
    assert_not_current "$target"
    if [ -e "$release" ] || [ -L "$release" ]; then
        [ -d "$release" ] && [ ! -L "$release" ] || die 'production release directory has an unsafe type'
        clear_exact_tree "$release"
    else
        install -d -m 755 "$release"
    fi
    mv "$source" "$target"
    if [ "$test_mode" = false ]; then
        chown -R root:root "$release"
    fi
    helper="$target/scripts/weknora-production/release-ci.sh"
    [ -f "$helper" ] && [ ! -L "$helper" ] || die 'release CI helper is unavailable'
    if [ "$test_mode" = false ]; then
        printf '%s\n%s\n' "$ghcr_username" "$ghcr_token" |
            WEKNORA_PRODUCTION_RUNTIME_DIR="$runtime_dir" \
            WEKNORA_PRODUCTION_REVISION="$revision" \
                bash "$helper" "$revision"
    elif [ "${MUSUW_DEPLOY_GATE_SKIP_RELEASE_CI:-0}" != 1 ]; then
        printf '%s\n%s\n' "$ghcr_username" "$ghcr_token" |
            WEKNORA_PRODUCTION_RUNTIME_DIR="$runtime_dir" \
            WEKNORA_PRODUCTION_REVISION="$revision" \
                bash "$helper" "$revision"
    fi
    unset ghcr_username ghcr_token
    clear_exact_tree "$incoming"
    rmdir "$incoming" 2>/dev/null || true
    printf '%s\n' "release deployed: $release_id"
}

[ "$#" -eq 2 ] || die 'usage: musuw-deploy-gate prepare|deploy <full-sha>'
verb="$1"
revision="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
safe_revision "$revision" || die 'release revision is unsafe'
release_id="musuw-$revision"

case "$verb" in
    prepare) prepare_incoming ;;
    deploy) deploy_release ;;
    *) die 'unknown musuw deploy gate protocol' ;;
esac
